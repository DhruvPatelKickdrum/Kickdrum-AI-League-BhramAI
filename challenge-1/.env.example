# OpenAI
OPENAI_API_KEY=sk-dummy-key-replace-with-real-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claim_verifier

# Cohere (optional, for reranking)
COHERE_API_KEY=

# Firecrawl (optional; when set, used for web search instead of OpenAI — faster)
FIRECRAWL_API_KEY=
# Use Firecrawl Agent (agentic extraction) + our LLM validation (default: false = search→LLM filter→scrape)
# FIRECRAWL_USE_AGENT=true
# FIRECRAWL_SEARCH_LIMIT=5
# FIRECRAWL_MAX_LINKS_TO_SCRAPE=1
# FIRECRAWL_SEARCH_TIMEOUT_MS=30000

# Application
SIMILARITY_THRESHOLD=0.6
MAX_AGENT_STEPS=10
# Cap agent reply length so the final summary step cannot hang (default 2048)
# MAX_AGENT_RESPONSE_TOKENS=2048
EMBEDDING_MODEL=text-embedding-3-small
# LLM for router, agent, verification, and web search (e.g. gpt-4o-mini, gpt-4.1-nano)
LLM_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
